{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,            // 👈 CRITICAL: Keeps things loose so old JS code doesn't error out
    "allowJs": true,            // 👈 CRITICAL: Allows JS and TS files to live together
    "checkJs": false,           // 👈 Don't type-check old JS files yet
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types","./src/types"],
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "ts-node": {
    "files": true
  }
}